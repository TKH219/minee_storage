<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials must not survive a reinstall: restoring these would put the
     previous account's session back on a device that has just been wiped. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
